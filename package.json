{
  "name": "brainlab-kanvas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:mock": "node scripts/dev.mjs --mock",
    "dev:server": "npm run dev -w @brainlab-kanvas/server",
    "dev:web": "npm run dev -w @brainlab-kanvas/web",
    "build": "npm run build -w @brainlab-kanvas/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
